#!/bin/bash
# PBS Pro variant of slurm_batch_chunks.sbatch.
# Submit with: qsub -J 0-11 scripts/pbs_batch.pbs
#PBS -N modexp
#PBS -l select=1:ncpus=24:mem=64gb
#PBS -l walltime=06:00:00
#PBS -o logs/^array_index^.out
#PBS -e logs/^array_index^.err
#PBS -J 0-11

set -euo pipefail
cd "$PBS_O_WORKDIR"
source .venv/bin/activate

CHUNK_SIZE=42
START=$(( PBS_ARRAY_INDEX * CHUNK_SIZE ))
END=$(( START + CHUNK_SIZE - 1 ))

mkdir -p logs experiments_overnight/out
python -m experiments_overnight.runner \
    --cells "${START}-${END}" \
    --workers 24 \
    --outdir experiments_overnight/out \
    --summary-csv experiments_overnight/out/summary_${PBS_ARRAY_INDEX}.csv
